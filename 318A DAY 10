import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        
        long n = scanner.nextLong();
        long k = scanner.nextLong();
        
   
        long numOdds = (n + 1) / 2;
        
        if (k <= numOdds) {
           
            System.out.println(2 * k - 1);
        } else {
            
            System.out.println(2 * (k - numOdds));
        }
        
        scanner.close();
    }
}
