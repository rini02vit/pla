import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        // Read the number of children (n) and time (t)
        int n = scanner.nextInt();
        int t = scanner.nextInt();
        
        // Read the initial queue arrangement string
        String s = scanner.next();
        char[] queue = s.toCharArray();
        
        for (int second = 0; second < t; second++) {
            for (int i = 0; i < n - 1; i++) {
                // If a boy is directly in front of a girl
                if (queue[i] == 'B' && queue[i + 1] == 'G') {
               
                    queue[i] = 'G';
                    queue[i + 1] = 'B';
              
                    i++; 
                }
            }
        }
        
        
        System.out.println(new String(queue));
        
        scanner.close();
    }
}
