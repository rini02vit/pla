import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        if (!sc.hasNextInt()) return;
        int n = sc.nextInt();
        
        int[] home = new int[n];
        int[] guest = new int[n];
        
        for (int i = 0; i < n; i++) {
            home[i] = sc.nextInt();
            guest[i] = sc.nextInt();
        }
        
        int conflictCount = 0;
        
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                // A team cannot play against itself
                if (i != j) {
                    if (home[i] == guest[j]) {
                        conflictCount++;
                    }
                }
            }
        }
        
        System.out.println(conflictCount);
        sc.close();
    }
}
